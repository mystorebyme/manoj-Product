# ─── TRENDS YOUNIQUE — storefront ────────────────────────────────────────────
# Site ka public URL (canonical, OG, WhatsApp links, invoice)
NEXT_PUBLIC_SITE_URL=https://trendsyounique.onrender.com

# ─── Google Sheet = database (owner ka panel) ───────────────────────────────
# Apps Script: scripts/google-apps-script/trends-sheets.gs → Deploy → Web app
# (Execute as: Me · Who has access: Anyone) → /exec URL yahan
GOOGLE_SHEETS_WEBAPP_URL=
GOOGLE_SHEETS_TOKEN=

# Products/photos ka local DB (default <repo>/.data) — admin panel bhi yahi use karta hai
DATA_DIR=

# ─── Optional: orders in Postgres (Render/Neon) ─────────────────────────────
DATABASE_URL=

# ─── Payments (UPI manual) — sheet se bhi badal sakte hain ──────────────────
STORE_UPI_ID=
STORE_UPI_NAME=TRENDS YOUNIQUE
STORE_WHATSAPP=8005900581

# ─── Notifications (optional) ───────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_TO=
