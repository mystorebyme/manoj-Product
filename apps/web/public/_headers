# Cloudflare Pages headers — TRENDS YOUNIQUE storefront (static export)
#
# Ye file build ke baad `dist/_headers` ban jaati hai (`scripts/pages/build-preview.mjs`
# ise copy karta hai). Cloudflare Pages ise utha kar har response par lagata hai.
#
# Rule: sirf fingerprinted assets (/ _next/static, / images) ko long cache;
# HTML aur JSON ko chhota cache — warna sheet se aaya naya price/stock purana dikhega.
#
# Dhyan: ek hi path ke liye ek hi block rakhein (duplicate `/*` block Cloudflare me
# pichhle block ko override kar deta hai).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy-Report-Only: default-src 'self'; img-src 'self' https://cdn.shopify.com https://*.shopifycdn.com https://img.trustoo.io https://script.google.com https://www.googletagmanager.com https://www.google-analytics.com data: blob:; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://www.google-analytics.com; frame-src https://script.google.com https://script.googleusercontent.com; form-action 'self' https://script.google.com; base-uri 'self'; object-src 'none'

# Next.js ke hashed build assets — naam badalne par hi content badalta hai
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Product images (build me hi aa jaati hain) — immutable
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Site data (catalog / pincode map / sheet endpoint) — 5 min cache, phir background refresh
/catalog-lite.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/catalog-index.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/pincode-map.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# HTML — kabhi lamba cache nahi (price/stock sheet se aate hain)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# cart / checkout / account / track-order: personal flow — cache bilkul nahi
/checkout
  Cache-Control: no-store
/checkout/*
  Cache-Control: no-store
/cart
  Cache-Control: no-store
/cart/*
  Cache-Control: no-store
/account
  Cache-Control: no-store
/account/*
  Cache-Control: no-store
/track-order
  Cache-Control: no-store
/track-order/*
  Cache-Control: no-store

# Admin panel is repo me deploy nahi hota — phir bhi safety
/admin
  Cache-Control: no-store
/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
