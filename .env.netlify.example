# Netlify → Site configuration → Environment variables → "Import environment variables"
# me ye poora content paste kar dein. Sab **public** (build-time) values hain —
# koi secret nahi. Import ke baad Deploy → Clear cache and retry.
#
# NOTE: static site hai, isliye Firebase OTP / Razorpay / DB jaise secrets ki
# zaroorat nahi (wahan customer WhatsApp + Google Sheet flow chalta hai).

# canonical URL — sitemap, OG image, WhatsApp link, structured data sab isi se
NEXT_PUBLIC_SITE_URL=https://trendsyounique.fashion

# root domain par site hai (GitHub Pages jaisa /repo/ prefix nahi)
PAGES_BASE_PATH=

# koi alag Node API nahi — checkout WhatsApp + Apps Script relay par chalta hai
NEXT_PUBLIC_API_BASE_URL=

# Google Search Console verification (pehle se meta tag me hai, yahan optional)
NEXT_PUBLIC_GSC_VERIFICATION=hFaqyp-9LdUXSKPA9RF011TkO2m_-7AUMasXqm_0dGI

# Google Analytics 4 — apna measurement ID daal dein (khaali = koi tracking nahi)
#NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Campaign rotate karne ke liye (khaali = campaign.ts ke dates ke hisaab se)
#NEXT_PUBLIC_CAMPAIGN_ID=diwali-2026
#NEXT_PUBLIC_CAMPAIGN_START=2026-10-24T00:00:00+05:30
#NEXT_PUBLIC_CAMPAIGN_END=2026-11-30T23:59:59+05:30

# Sheet relay ka URL/token code me verified hai (apps/web/src/lib/sheet-config.ts).
# Sirf naya Apps Script deployment lene par ye do use karein:
#NEXT_PUBLIC_SHEET_URL_OVERRIDE=https://script.google.com/macros/s/XXXX/exec
#NEXT_PUBLIC_SHEET_TOKEN_OVERRIDE=tyw-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
