# TRENDS YOUNIQUE — Netlify environment variables (real values, paste-ready)
# Netlify → Site configuration → Environment variables → Import environment variables
# → neeche ka poora content paste → Import → Deploys → Clear cache and retry
#
# Sab public (build-time) values hain — koi secret nahi. Static site hai:
# Firebase OTP / Razorpay / DB / master sheet token server ke liye hain,
# Netlify par use hi nahi hote.

NEXT_PUBLIC_SITE_URL=https://trendsyounique.fashion

NEXT_PUBLIC_GSC_VERIFICATION=hFaqyp-9LdUXSKPA9RF011TkO2m_-7AUMasXqm_0dGI

NEXT_PUBLIC_CAMPAIGN_ID=diwali-2026
NEXT_PUBLIC_CAMPAIGN_START=2026-10-24T00:00:00+05:30
NEXT_PUBLIC_CAMPAIGN_END=2026-11-30T23:59:59+05:30

# Itna hi. Baaki sab pehle se sahi hai:
#   PAGES_BASE_PATH=""              → netlify.toml me (root domain, koi /repo/ prefix nahi)
#   NEXT_PUBLIC_API_BASE_URL=""     → netlify.toml me (koi Node API nahi)
#   Sheet relay URL + token         → apps/web/src/lib/sheet-config.ts (verified deployment)
#
# GA4: site par abhi koi measurement ID nahi hai. Google Analytics me property
# banane ke baad **sirf ye ek line** add karein (fir Clear cache and retry):
#   NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX   ← asli ID, X wala nahi
